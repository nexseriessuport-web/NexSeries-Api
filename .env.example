# ── Core ──────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
LOG_LEVEL=INFO
API_KEY=changeme             # Bearer token clients must send (leave blank to disable auth)

# ── Cache ─────────────────────────────────────────────────────────────
CACHE_BACKEND=memory         # memory | redis
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SEARCH=300         # seconds
CACHE_TTL_DETAILS=600
CACHE_TTL_EPISODES=300
CACHE_TTL_TRENDING=900
CACHE_TTL_SCHEDULE=3600

# ── Provider toggles ──────────────────────────────────────────────────
PROVIDER_ANILIST_ENABLED=true
PROVIDER_JIKAN_ENABLED=true
PROVIDER_ANIKITO_ENABLED=false   # UNTESTED — enable only after contract tests pass
PROVIDER_MIRURO_ENABLED=false    # UNTESTED
PROVIDER_ANIVAULT_ENABLED=false  # UNTESTED
PROVIDER_YUMEZONE_ENABLED=false  # UNTESTED

# ── Request tuning ────────────────────────────────────────────────────
HTTP_TIMEOUT=10              # seconds per request
HTTP_MAX_RETRIES=3
HTTP_CONCURRENCY_LIMIT=20

# ── Rate limits (requests / window_seconds per provider) ──────────────
RATE_ANILIST_RPM=90          # AniList public limit ~90/min
RATE_JIKAN_RPM=60            # Jikan recommends ≤3/s sustained
